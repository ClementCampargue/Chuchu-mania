  lines:
  - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
    text: "H\xE9 Chuchu,<p=2> tu penses quoi de Stellaman?"
    hasChoices: 1
    choices:
    - choiceText: Connais pas
      answer:
      - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
        text: <sh>COMMENT OSES-TU?!</sh>
        hasChoices: 0
        choices:
        - choiceText: Je rigooooole
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: ah merci
            hasChoices: 0
            choices: []
          actionID: 
        - choiceText: "allez d\xE9gage"
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: Ah
            hasChoices: 0
            choices: []
          actionID: 
      - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
        text: Attends...
        hasChoices: 0
        choices:
        - choiceText: Je rigooooole
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: ah merci
            hasChoices: 0
            choices: []
          actionID: 
        - choiceText: "allez d\xE9gage"
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: Ah
            hasChoices: 0
            choices: []
          actionID: 
      - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
        text: "Tu blaguais c'est \xE7a?"
        hasChoices: 0
        choices:
        - choiceText: Je rigooooole
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: ah merci
            hasChoices: 0
            choices: []
          actionID: 
        - choiceText: "allez d\xE9gage"
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: Ah
            hasChoices: 0
            choices: []
          actionID: 
      - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
        text: Il faut vraiment que tu te calmes avec Stellaman, Cuicui...
        hasChoices: 0
        choices:
        - choiceText: Je rigooooole
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: ah merci
            hasChoices: 0
            choices: []
          actionID: 
        - choiceText: "allez d\xE9gage"
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: Ah
            hasChoices: 0
            choices: []
          actionID: 
      actionID: 
    - choiceText: Juste le boss en fait
      answer:
      - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
        text: <sh>MAIS OUI!</sh><p=5> C'est la plus grande oeuvre la galaxie!
        hasChoices: 0
        choices: []
      - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
        text: Alors pourquoi ta copine me dit que c'est juste mid?
        hasChoices: 0
        choices: []
      - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
        text: "Oh euh...<p=5> Magenta a des go\xFBts <w>tr\xE8s particuliers</w>
          en mati\xE8re de s\xE9ries."
        hasChoices: 0
        choices: []
      - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
        text: "Ah ouais?<p=5> Je veux tout savoir! <p=5>J'aimerais regarder une s\xE9rie
          avec elle!"
        hasChoices: 0
        choices:
        - choiceText: Doki Doki Sparkling Star
          answer:
          - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
            text: "Je n'arrive pas \xE0 comprendre ce que c'est mais elle est parle
              tout le temps!"
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
            text: "Je crois que c'est une histoire entre deux fille au lyc\xE9e?"
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
            text: Ca al'air tout pourri
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: "H\xE9 je vous entends d'ici bande d'idiots!"
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: "Doki Doki Sparkling Star est un chef d'oeuvre de narration sur
              la romance impossible entre deux lyc\xE9ennes!"
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: "Tout cela habilement retranscris avec un dessin d\xE9licat et
              po\xE9tique, arborant des sujets complexes."
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: C'est un classique du yuri bande d'incultes!
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
            text: ...
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
            text: Y a de la bagarre?
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: UGH!...
            hasChoices: 0
            choices: []
          actionID: 
        - choiceText: Stone Decay
          answer:
          - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
            text: "C'est une s\xE9rie polici\xE8re o\xF9 les gens se font transformer
              en pierre!"
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
            text: "L'h\xE9roine est une harpie qui doit enqu\xEAter sur cette affaire
              et elle rencontre une vampire et... euh..."
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
            text: Et puis quoi?...
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
            text: "On en reparlera dans quelques ann\xE9es"
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
            text: Ca a l'air giga degen ton truc
            hasChoices: 0
            choices: []
          actionID: 
      - character: {fileID: 11400000, guid: d545f39ec73e8a94f874387ac2d04a27, type: 2}
        text: Tu me conseilles quoi?
        hasChoices: 1
        choices:
        - choiceText: Doki Doki Sparkling Star
          answer:
          - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
            text: "Je n'arrive pas \xE0 comprendre ce que c'est mais elle en parle
              tout le temps!"
            hasChoices: 0
            choices: []
          - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
            text: "Je crois que c'est l'histoire de deux filles qui pensent \xE0
              des trucs compliqu\xE9s?"
