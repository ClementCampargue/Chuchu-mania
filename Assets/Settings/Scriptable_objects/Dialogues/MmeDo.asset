  - character: {fileID: 11400000, guid: f88182c79c0a16845894818183e4f9c5, type: 2}
    text: "Hmpf...<p=5> Jolli-Jelli,<p=2> encore en train de sauter partout comme
      un macaque de l'espace. <p=5>O\xF9 vas-tu comme \xE7a?"
    hasChoices: 0
    choices:
    - choiceText: 
      answer: []
      actionID: 
    - choiceText: 
      answer: []
      actionID: 
  - character: {fileID: 11400000, guid: 358c18f725108b14d9b9efeb15db2fc1, type: 2}
    text: "C'est marrant de sauter!<p=5> J'ai l'impression \xE0 chaque bond de m'approcher
      des \xE9toiles!"
    hasChoices: 0
    choices:
    - choiceText: Non
      answer:
      - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
        text: Ah
        hasChoices: 0
        choices:
        - choiceText: Je rigooooole
          answer:
          - character: {fileID: 11400000, guid: 201e18955e3c1254fae5fd2b355c5cac, type: 2}
            text: ah merci
            hasChoices: 0
            choices: []
          actionID: 
        - choiceText: "allez d\xE9gage"
