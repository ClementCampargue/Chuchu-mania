  m_SharedData: {fileID: 11400000, guid: 138a4e0e2d3e70b4ebfbd993cc4371bc, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 13540277396193280
    m_Localized: Hey Chuchu, <p=2>what's your opinion on Stellaman?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193282
    m_Localized: Who?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193283
    m_Localized: <sh>HOW DARE YOU?!</sh>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193284
    m_Localized: Wait<p=5>.<p=5>.<p=5>.
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193285
    m_Localized: You were joking huh?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193286
    m_Localized: "You really have to ,<p=2> Cuicui\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193288
    m_Localized: My man!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193289
    m_Localized: <sh>YESSS!</sh><p=5> This is the best work of the galaxy!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193290
    m_Localized: So why is your girlfriend telling me it's just mid?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193291
    m_Localized: Well...<p=5> Magenta has <w>very specific</w> tastes in shows,
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193292
    m_Localized: Oh really?<p=5> I want to know everything! <p=5>I'd be glad to watch
      some show with her!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193293
    m_Localized: What would you suggest?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193295
    m_Localized: Doki Doki Sparkling Star
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193296
    m_Localized: I'm not entirely sure what's this all about but she's always talking
      about it!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193297
    m_Localized: I believe it's the story of two girls thinking about complex stuff?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193298
    m_Localized: Sounds like trash
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193299
    m_Localized: Hey, <p=2>I can hear you two idiots from here!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193300
    m_Localized: Doki Doki is a masterpiece of narration of the impossible romance
      between two schoolgirls!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193301
    m_Localized: All of it
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193302
    m_Localized: It's a yuri classic,<p=2> you
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193303
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193304
    m_Localized: Is there any fight in it?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193305
    m_Localized: <sh>URGH!...</sh>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193307
    m_Localized: Stone Decay
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193314
    m_Localized: <w>Hi Maggy!</w>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193315
    m_Localized: Yo Marshmallow, <p=2>anything in mind for tonight?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193317
    m_Localized: What about
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193318
    m_Localized: Oh?<p=5> Feeling fancy?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193319
    m_Localized: I'm just
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193323
    m_Localized: You know how to talk to girls
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193324
    m_Localized: That will be all?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193330
    m_Localized: "Hmm\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193331
    m_Localized: <w>Yeah...</w>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193337
    m_Localized: Hmpf...<p=5> Jolli-Jelli,<p=2> always jumping around like a vulagr
      space monkey. <p=5>Where do you think you're going?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193338
    m_Localized: Jumping is fun!<p=5> I have the feeling I can reach the stars with
      each bounce!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193339
    m_Localized: This girl is hopeless...
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193340
    m_Localized: "Oh don't be so hard on the lass, <p=2> ch\xE9rie."
    m_Metadata:
      m_Items: []
  - m_Id: 13540277396193341
    m_Localized: You should be coming back to earth and pay your debts instead of
      opening your mouth.
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581888
    m_Localized: "Y<p=1>-yes Merry dear\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581890
    m_Localized: "Hello Mr D\xF4!"
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581891
    m_Localized: <sh>MISTER DOOOOOOOOOOOOOOOOOOOOOOOOOOOOO!!!</sh>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581894
    m_Localized: <sh>CHUCHUUUUUUUUUUUUUUUUUUUU!</sh>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581895
    m_Localized: <w>Howdy!</w>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581896
    m_Localized: You gotta help me break da law!
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581897
    m_Localized: Wait what?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581901
    m_Localized: "Grmbl\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581907
    m_Localized: Leave her alone
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581909
    m_Localized: Bother her
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581910
    m_Localized: What are you doing Yanya?
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581911
    m_Localized: <sh>!!!</sh>
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581912
    m_Localized: "Oh uh...<p=5> hi Chuchu\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581913
    m_Localized: I was...<p=5> I was just thinking
    m_Metadata:
      m_Items: []
  - m_Id: 13540277404581914
    m_Localized: You looked very
    m_Metadata:
      m_Items: []
  references:
    version: 2
