  m_SharedData: {fileID: 11400000, guid: b3eec409a99cf0744945d380db858a5e, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 41571598336
    m_Localized: In the center of the universe, <p=2> there is a magic place in which...
    m_Metadata:
      m_Items: []
  - m_Id: 48718692352
    m_Localized: You can taste the most exquisite and exotic savors in the galaxy!
    m_Metadata:
      m_Items: []
  - m_Id: 56469766144
    m_Localized: <sh>Heeeeeeeeeeeeeeelp!!!</sh>
    m_Metadata:
      m_Items: []
  - m_Id: 58717913088
    m_Localized: A little star suddenly appeared and crashed onto Chuchu's stand!
    m_Metadata:
      m_Items: []
  - m_Id: 60953477120
    m_Localized: Oi welcome!<p=5> You want some ice-cream?<p=5> What flavor?
    m_Metadata:
      m_Items: []
  - m_Id: 63247761408
    m_Localized: I'm not here to order!<p=5> My friends have been captured by Queen
      Lychee for her grand party!
    m_Metadata:
      m_Items: []
  - m_Id: 65630126080
    m_Localized: <w>Oh<p=2>oh<p=2>oh<p=2>oh!<p=5></w> These tiny plushies will be
      the centerpiece to make my party so stellar!
    m_Metadata:
      m_Items: []
  - m_Id: 13208326520832
    m_Localized: Please,<p=2> help us,<p=2> stellanaut Chuchu!
    m_Metadata:
      m_Items: []
  - m_Id: 13208326520833
    m_Localized: These words were enough to lighten the little jelly's heart!
    m_Metadata:
      m_Items: []
  - m_Id: 13208326520834
    m_Localized: You can count on me!
    m_Metadata:
      m_Items: []
  - m_Id: 13208326520835
    m_Localized: And thus,<p=2> Chuchu went to the rescue to save these little star
      spirits, captures by the moon bunnies in the whole galaxy!
    m_Metadata:
      m_Items: []
  - m_Id: 13208326520836
    m_Localized: 'Direction: <p=2> Bubble Beach Galaxy!'
    m_Metadata:
      m_Items: []
  - m_Id: 13208326520837
    m_Localized: '***'
    m_Metadata:
      m_Items: []
  references:
    version: 2
